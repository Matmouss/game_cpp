@startuml
skinparam classAttributeIconSize 0

class Entite {
  #nom : string
  #description : string
  #hp : int
  #hpMax : int
  #atk : int
  #def : int
  #mercy : int
  #mercyGoal : int
  #inventaireACT : Act**
  #tailleInventaireACT : int
  #stats : Stat**
  #tailleStats : int

  +Entite()
}

class Personnage {
  -nbTue : int
  -nbEpargne : int
  -nbVictoire : int
  -inventaireItems : Item**
  -tailleInventaire : int

  +Personnage()
}

class Monstre {
  -resultatCombat : string

  +Monstre()
}

class MonstreLambda {
  -nbActions : int = 2
  +MonstreLambda()
}

class MiniBoss {
  -nbActions : int = 3
  +MiniBoss()
}

class Boss {
  -nbActions : int = 4
  +Boss()
}

class Act {
  +identifiant : string
  +texte : string
  {static} nbActionsPossibles : int

  +Act()
}

class SerrerMain {
  +SerrerMain()
}

class Dodo {
  +Dodo()
}

class Item {
  -nom : string
  -type : string
  -texte : string
  -valeur : int

  +Item()
}

class Stat {
  +nom : string
  +valeur : int
  +initValeur : int

  +Stat()
}

class Vulnerabilite {
  +Vulnerabilite()
}

class Partie {
  +personnage : Personnage*
  +bestiaire : Monstre**
  +tailleBestiaire : int
  +monstresPossibles : Monstre**
  +tailleMonstresPossibles : int
  +catalogueACT : Act**
  +tailleCatalogueACT : int
  +itemPossible : Item**
  +tailleItemPossible : int

  +Partie()
}

Entite <|-- Personnage : public
Entite <|-- Monstre : public
Monstre <|-- MonstreLambda : public
Monstre <|-- MiniBoss : public
Monstre <|-- Boss : public

Act <|-- SerrerMain : public
Act <|-- Dodo : public
Stat <|-- Vulnerabilite : public

Entite o-- "0..*" Act : inventaireACT
Entite *-- "0..*" Stat : stats
Personnage o-- "0..*" Item : inventaire

Partie *-- "1" Personnage
Partie o-- "0..*" Monstre : bestiaire
Partie *-- "0..*" Monstre : monstresPossibles
Partie o-- "0..*" Act : catalogue
Partie *-- "0..*" Item : items

@enduml